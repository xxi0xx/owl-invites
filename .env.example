# =============================================================================
# Owl Invites Configuration
# =============================================================================
# Copy this file to .env and customize for your deployment.

# Server
PORT=8080
ENV=development
# ENV=production

# Database
DB_DRIVER=sqlite
DB_DSN=/data/owl-invites.db
# For PostgreSQL:
# DB_DRIVER=postgres
# DB_DSN=postgres://user:pass@localhost:5432/owl_invites?sslmode=disable
# When using docker-compose.postgres.yml, the following must be set
# (the compose file refuses to start without them):
# POSTGRES_USER=owl_invites
# POSTGRES_PASSWORD=change-me-to-something-strong
# POSTGRES_DB=owl_invites

# Auth
MAGIC_LINK_EXPIRY=15m
SESSION_EXPIRY=168h
BASE_URL=http://localhost:8080
ALLOW_SIGNUPS=false

# Fresh Owl Invites installations require a high-entropy, operator-provided
# token to create the first administrator. Keep this env-only; it becomes
# useless after setup is committed. Example generation: openssl rand -hex 32
OWL_INVITES_BOOTSTRAP_TOKEN=
OWL_INVITES_ACCOUNT_INVITE_EXPIRY=72h

# REQUIRED. Stable HMAC key for private invitation and open-enrollment
# capabilities. This is critical restore material: back it up with the
# database. Losing or changing it invalidates every capability link.
# Example generation: openssl rand -base64 48
OWL_INVITES_SECRET_KEY=
# Alternatively remove/comment OWL_INVITES_SECRET_KEY and set exactly one file
# source. A terminal LF/CRLF is removed; other bytes are preserved.
# OWL_INVITES_SECRET_KEY_FILE=/run/secrets/owl_invites_secret_key
OWL_INVITES_INVITATION_SESSION_EXPIRY=720h
OWL_INVITES_INVITATION_RECOVERY_EXPIRY=15m

# Email Notifications
# Provider: smtp, sendgrid, ses
NOTIFICATION_EMAIL_PROVIDER=smtp

# SMTP settings (used when provider=smtp)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@owl-invites.local

# SendGrid settings (used when provider=sendgrid)
# SENDGRID_API_KEY=SG.xxxxx
# SENDGRID_FROM=noreply@yourdomain.com

# AWS SES settings (used when provider=ses)
# SES_REGION=us-east-1
# SES_USERNAME=your-ses-smtp-username
# SES_PASSWORD=your-ses-smtp-password
# SES_FROM=noreply@yourdomain.com

# SMS Notifications (optional)
# Provider: twilio, vonage, sns
# NOTIFICATION_SMS_PROVIDER=twilio
# Human-readable sender identity included in invitation SMS messages.
# Configure this to match the identity registered with your messaging provider.
# NOTIFICATION_SMS_SENDER_NAME=Owl Invites

# Twilio settings
# TWILIO_ACCOUNT_SID=ACxxxxx
# TWILIO_AUTH_TOKEN=xxxxx
# TWILIO_FROM_NUMBER=+15551234567

# Vonage settings
# VONAGE_API_KEY=xxxxx
# VONAGE_API_SECRET=xxxxx
# VONAGE_FROM=OwlInvites

# Amazon SNS settings (used when provider=sns)
# SNS_SMS_REGION=us-east-1
# SNS_SMS_ACCESS_KEY_ID=AKIAxxxxx
# SNS_SMS_SECRET_ACCESS_KEY=xxxxx

# Feedback
# At least one channel must be configured or submissions are silently discarded.
#
# Option 1 — GitHub Issues (recommended): create a Personal Access Token with
# repo scope (classic) or Issues write permission (fine-grained), then set the
# target repo as "owner/repo".
# FEEDBACK_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# FEEDBACK_GITHUB_REPO=yourorg/yourrepo
#
# Option 2 — Email fallback: requires SMTP (or other email provider) to be configured.
# FEEDBACK_EMAIL=feedback@yourdomain.com

# Data Retention
DEFAULT_RETENTION_DAYS=30

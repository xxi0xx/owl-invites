{
  "openapi": "3.1.0",
  "info": {
    "title": "Owl Invites API",
    "version": "0.1.0",
    "description": "Gate 2 identity, event membership, invitation household, and RSVP capability contract."
  },
  "servers": [{ "url": "/api/v1" }],
  "components": {
    "securitySchemes": {
      "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "session" },
      "invitationSessionCookie": { "type": "apiKey", "in": "cookie", "name": "owl_invitation_session" }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "email", "name", "timezone", "instanceRole", "status", "isAdmin", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "name": { "type": "string" },
          "timezone": { "type": "string" },
          "instanceRole": { "type": "string", "enum": ["admin", "user"] },
          "status": { "type": "string", "enum": ["invited", "active", "disabled"] },
          "isAdmin": { "type": "boolean", "deprecated": true },
          "invitedByUserId": { "type": "string", "format": "uuid" },
          "activatedAt": { "type": "string", "format": "date-time" },
          "lastLoginAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "InstanceSettings": {
        "type": "object",
        "required": ["instanceName", "defaultTimezone", "allowSignups", "supportEmail", "configured"],
        "properties": {
          "instanceName": { "type": "string", "maxLength": 200 },
          "defaultTimezone": { "type": "string", "maxLength": 100 },
          "allowSignups": { "type": "boolean" },
          "supportEmail": { "type": "string" },
          "configured": { "type": "boolean", "readOnly": true }
        }
      },
      "InstanceSettingsUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instanceName", "defaultTimezone", "allowSignups", "supportEmail"],
        "properties": {
          "instanceName": { "type": "string", "maxLength": 200 },
          "defaultTimezone": { "type": "string", "maxLength": 100 },
          "allowSignups": { "type": "boolean" },
          "supportEmail": { "type": "string" }
        }
      },
      "SetupStatus": {
        "type": "object",
        "required": ["configured", "setupRequired"],
        "properties": {
          "configured": { "type": "boolean" },
          "setupRequired": { "type": "boolean" }
        }
      },
      "BootstrapRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bootstrapToken", "adminEmail", "adminName", "instanceName", "defaultTimezone", "allowSignups", "supportEmail"],
        "properties": {
          "bootstrapToken": { "type": "string" },
          "adminEmail": { "type": "string", "format": "email" },
          "adminName": { "type": "string", "maxLength": 200 },
          "instanceName": { "type": "string", "maxLength": 200 },
          "defaultTimezone": { "type": "string", "maxLength": 100 },
          "allowSignups": { "type": "boolean", "default": false },
          "supportEmail": { "type": "string", "format": "email" }
        }
      },
      "AccountInvite": {
        "type": "object",
        "required": ["id", "targetUserId", "email", "invitedByUserId", "expiresAt", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "targetUserId": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "invitedByUserId": { "type": "string", "format": "uuid" },
          "eventId": { "type": "string", "format": "uuid" },
          "eventRole": { "type": "string", "enum": ["cohost"] },
          "expiresAt": { "type": "string", "format": "date-time" },
          "acceptedAt": { "type": "string", "format": "date-time" },
          "revokedAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "AuditEntry": {
        "type": "object",
        "required": ["id", "actorKind", "action", "metadata", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "actorUserId": { "type": "string", "format": "uuid" },
          "actorKind": { "type": "string", "enum": ["user", "cli", "system"] },
          "action": { "type": "string" },
          "targetUserId": { "type": "string", "format": "uuid" },
          "eventId": { "type": "string", "format": "uuid" },
          "metadata": { "type": "object", "additionalProperties": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Event": {
        "type": "object",
        "required": ["id", "organizerId", "title", "description", "eventDate", "location", "timezone", "retentionDays", "status", "showHeadcount", "showGuestList", "seriesOverride", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "organizerId": { "type": "string", "format": "uuid", "description": "Owner user derived from the authoritative event_memberships row." },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "eventDate": { "type": "string", "format": "date-time" },
          "endDate": { "type": "string", "format": "date-time" },
          "location": { "type": "string" },
          "timezone": { "type": "string" },
          "retentionDays": { "type": "integer" },
          "status": { "type": "string", "enum": ["draft", "published", "cancelled", "archived"] },
          "showHeadcount": { "type": "boolean" },
          "showGuestList": { "type": "boolean" },
          "rsvpDeadline": { "type": "string", "format": "date-time" },
          "seriesId": { "type": "string", "format": "uuid" },
          "seriesIndex": { "type": "integer" },
          "seriesOverride": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "EventMembership": {
        "type": "object",
        "required": ["id", "eventId", "userId", "role", "grantedByUserId", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "eventId": { "type": "string", "format": "uuid" },
          "userId": { "type": "string", "format": "uuid" },
          "role": { "type": "string", "enum": ["owner", "cohost"] },
          "grantedByUserId": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "name": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Invitation": {
        "type": "object",
        "required": ["id", "eventId", "label", "preferredDeliveryMethod", "additionalGuestAllowance", "source", "tokenVersion", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "eventId": { "type": "string", "format": "uuid" },
          "label": { "type": "string", "maxLength": 200 },
          "contactEmail": { "type": "string", "format": "email" },
          "contactPhone": { "type": "string" },
          "preferredDeliveryMethod": { "type": "string", "enum": ["email", "sms", "none"], "description": "Stored contact preference. Gate 2 sends household capabilities and recovery only when this value is email." },
          "additionalGuestAllowance": { "type": "integer", "minimum": 0 },
          "source": { "type": "string", "enum": ["private", "open"] },
          "tokenVersion": { "type": "integer", "minimum": 1 },
          "revokedAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "InvitationGuest": {
        "type": "object",
        "required": ["id", "invitationId", "name", "origin", "attendance"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "invitationId": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "origin": { "type": "string", "enum": ["assigned", "additional"] },
          "attendance": { "type": "string", "enum": ["pending", "attending", "maybe", "declined"] }
        }
      },
      "InvitationQuestion": {
        "type": "object",
        "required": ["id", "label", "type", "options", "required", "scope", "sortOrder"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "label": { "type": "string" },
          "type": { "type": "string", "enum": ["text", "select", "checkbox"] },
          "options": { "type": "array", "items": { "type": "string" } },
          "required": { "type": "boolean" },
          "scope": { "type": "string", "enum": ["invitation", "guest"] },
          "sortOrder": { "type": "integer" }
        }
      },
      "GuestInvitationPresentation": {
        "type": "object",
        "required": ["templateId", "heading", "body", "footer", "primaryColor", "secondaryColor", "font"],
        "properties": {
          "templateId": { "type": "string" },
          "heading": { "type": "string" },
          "body": { "type": "string" },
          "footer": { "type": "string" },
          "primaryColor": { "type": "string" },
          "secondaryColor": { "type": "string" },
          "font": { "type": "string" },
          "backgroundImage": { "type": "string", "description": "Revalidated public upload or HTTPS image URL. Storage paths and arbitrary invite custom data are never exposed." }
        }
      },
      "InvitationDeliverySummary": {
        "type": "object",
        "required": ["status", "deliveryStatus", "provider", "attemptedAt"],
        "properties": {
          "status": { "type": "string", "enum": ["pending", "sent", "failed"] },
          "deliveryStatus": { "type": "string", "enum": ["unknown", "delivered", "opened", "clicked", "bounced", "complained"] },
          "provider": { "type": "string" },
          "error": { "type": "string" },
          "attemptedAt": { "type": "string", "format": "date-time" },
          "sentAt": { "type": "string", "format": "date-time" }
        }
      },
      "InvitationHousehold": {
        "type": "object",
        "required": ["invitation", "event", "response", "guests", "questions", "invitationAnswers", "guestAnswers", "presentation"],
        "properties": {
          "invitation": { "$ref": "#/components/schemas/Invitation" },
          "event": { "type": "object", "additionalProperties": true },
          "response": { "type": "object", "additionalProperties": true },
          "guests": { "type": "array", "items": { "$ref": "#/components/schemas/InvitationGuest" } },
          "questions": { "type": "array", "items": { "$ref": "#/components/schemas/InvitationQuestion" } },
          "invitationAnswers": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "guestAnswers": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "presentation": { "$ref": "#/components/schemas/GuestInvitationPresentation" },
          "latestDelivery": { "$ref": "#/components/schemas/InvitationDeliverySummary", "description": "Organizer-only latest email attempt. Omitted from guest household-session responses." }
        }
      },
      "CreateInvitationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "preferredDeliveryMethod", "additionalGuestAllowance", "assignedGuestNames"],
        "properties": {
          "label": { "type": "string", "maxLength": 200 },
          "contactEmail": { "type": "string", "format": "email" },
          "contactPhone": { "type": "string" },
          "preferredDeliveryMethod": { "type": "string", "enum": ["email", "sms", "none"], "description": "SMS and none are metadata-only for manually managed invitations in Gate 2." },
          "additionalGuestAllowance": { "type": "integer", "minimum": 0, "maximum": 50 },
          "assignedGuestNames": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "send": { "type": "boolean", "description": "When true, preferredDeliveryMethod must be email and contactEmail must be valid. Creation remains successful if the post-commit email attempt later fails." }
        }
      },
      "UpdateInvitationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "preferredDeliveryMethod", "additionalGuestAllowance", "assignedGuests"],
        "properties": {
          "label": { "type": "string", "maxLength": 200 },
          "contactEmail": { "type": "string", "format": "email" },
          "contactPhone": { "type": "string" },
          "preferredDeliveryMethod": { "type": "string", "enum": ["email", "sms", "none"] },
          "additionalGuestAllowance": { "type": "integer", "minimum": 0, "maximum": 50 },
          "assignedGuests": {
            "type": "array", "minItems": 1, "maxItems": 100,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["name"],
              "properties": { "id": { "type": "string", "format": "uuid" }, "name": { "type": "string", "maxLength": 200 } }
            }
          }
        }
      },
      "InvitationDeliveryResult": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["not_requested", "sent", "failed"] },
          "warning": { "type": "string", "description": "A nonfatal, capability-free warning when resource persistence succeeded but delivery failed." }
        }
      },
      "CreateInvitationResult": {
        "type": "object",
        "required": ["invitation", "guests", "accessUrl", "delivery"],
        "properties": {
          "invitation": { "$ref": "#/components/schemas/Invitation" },
          "guests": { "type": "array", "items": { "$ref": "#/components/schemas/InvitationGuest" } },
          "accessUrl": { "type": "string", "description": "Private capability URL returned to the organizer. The capability is carried in the URL fragment and is not persisted in plaintext." },
          "delivery": { "$ref": "#/components/schemas/InvitationDeliveryResult" }
        }
      },
      "InvitationCapabilityRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability"],
        "properties": { "capability": { "type": "string" } }
      },
      "InvitationSubmitRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "assignedGuests", "additionalGuests", "invitationAnswers", "guestAnswers"],
        "properties": {
          "version": { "type": "integer", "minimum": 1 },
          "assignedGuests": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "additionalGuests": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "invitationAnswers": { "type": "object", "additionalProperties": true },
          "guestAnswers": { "type": "object", "additionalProperties": true }
        }
      },
      "RecoveryRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId", "contact"],
        "properties": {
          "eventId": { "type": "string" },
          "contact": { "type": "string" }
        }
      },
      "OpenEnrollmentConfigRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled", "maxPartySize"],
        "properties": {
          "enabled": { "type": "boolean" },
          "opensAt": { "type": "string", "format": "date-time" },
          "closesAt": { "type": "string", "format": "date-time" },
          "maxPartySize": { "type": "integer", "minimum": 1, "maximum": 50 },
          "capacity": { "type": "integer", "minimum": 1 }
        }
      },
      "OpenEnrollmentConfig": {
        "type": "object",
        "required": ["id", "eventId", "enabled", "maxPartySize", "tokenVersion", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "eventId": { "type": "string", "format": "uuid" },
          "enabled": { "type": "boolean" },
          "opensAt": { "type": "string", "format": "date-time" },
          "closesAt": { "type": "string", "format": "date-time" },
          "maxPartySize": { "type": "integer", "minimum": 1, "maximum": 50 },
          "capacity": { "type": "integer", "minimum": 1 },
          "tokenVersion": { "type": "integer", "minimum": 1 },
          "revokedAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "OpenEnrollmentResult": {
        "type": "object",
        "required": ["config", "accessUrl"],
        "properties": {
          "config": { "$ref": "#/components/schemas/OpenEnrollmentConfig" },
          "accessUrl": { "type": "string", "description": "Open-enrollment capability URL using a fragment." }
        }
      },
      "InvitationMessageRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recipientGroup", "subject", "body"],
        "properties": {
          "recipientGroup": { "type": "string", "enum": ["all", "attending", "maybe", "declined", "pending"] },
          "subject": { "type": "string", "maxLength": 200 },
          "body": { "type": "string", "maxLength": 10000 }
        }
      },
      "InvitationMessageResult": {
        "type": "object",
        "required": ["sent"],
        "properties": { "sent": { "type": "integer", "minimum": 0 } }
      },
      "InvitationImportIssue": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "row": { "type": "integer", "minimum": 0 },
          "field": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "InvitationImportHousehold": {
        "type": "object",
        "additionalProperties": false,
        "required": ["householdKey", "householdLabel", "preferredDelivery", "additionalGuestAllowance", "assignedGuestNames"],
        "properties": {
          "householdKey": { "type": "string", "maxLength": 100, "description": "Import-only grouping value; never persisted as invitation identity." },
          "householdLabel": { "type": "string", "maxLength": 200 },
          "contactEmail": { "type": "string", "format": "email" },
          "contactPhone": { "type": "string" },
          "preferredDelivery": { "type": "string", "enum": ["email", "sms", "none"] },
          "additionalGuestAllowance": { "type": "integer", "minimum": 0, "maximum": 50 },
          "assignedGuestNames": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "maxLength": 200 } }
        }
      },
      "InvitationImportPreview": {
        "type": "object",
        "required": ["householdCount", "assignedGuestCount", "households", "errors", "warnings"],
        "properties": {
          "householdCount": { "type": "integer", "minimum": 0 },
          "assignedGuestCount": { "type": "integer", "minimum": 0 },
          "households": { "type": "array", "items": { "$ref": "#/components/schemas/InvitationImportHousehold" } },
          "errors": { "type": "array", "items": { "$ref": "#/components/schemas/InvitationImportIssue" } },
          "warnings": { "type": "array", "items": { "$ref": "#/components/schemas/InvitationImportIssue" } }
        }
      },
      "InvitationImportCommitRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["households"],
        "properties": {
          "households": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/components/schemas/InvitationImportHousehold" } }
        }
      },
      "InvitationImportCommitResult": {
        "type": "object",
        "required": ["householdCount", "assignedGuestCount", "invitationIds"],
        "properties": {
          "householdCount": { "type": "integer", "minimum": 1 },
          "assignedGuestCount": { "type": "integer", "minimum": 1 },
          "invitationIds": { "type": "array", "items": { "type": "string", "format": "uuid" } }
        }
      },
      "OpenEnrollmentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "label", "contactEmail", "preferredDeliveryMethod", "guestNames"],
        "properties": {
          "capability": { "type": "string" },
          "label": { "type": "string" },
          "contactEmail": { "type": "string", "format": "email" },
          "contactPhone": { "type": "string" },
          "preferredDeliveryMethod": { "type": "string", "enum": ["email"], "description": "Gate 2 open enrollment is email-only so every new household can receive and recover its durable management capability." },
          "guestNames": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      },
      "OpenEnrollmentCreateResult": {
        "type": "object",
        "required": ["data", "delivery"],
        "properties": {
          "data": { "$ref": "#/components/schemas/InvitationHousehold" },
          "delivery": { "$ref": "#/components/schemas/InvitationDeliveryResult" }
        }
      }
    }
  },
  "paths": {
    "/openapi.json": {
      "get": {
        "operationId": "getOpenAPIContract",
        "responses": { "200": { "description": "OpenAPI 3.1 contract", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } } }
      }
    },
    "/setup/status": {
      "get": {
        "operationId": "getSetupStatus",
        "responses": { "200": { "description": "Setup state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SetupStatus" } } } } }
      }
    },
    "/setup/bootstrap": {
      "post": {
        "operationId": "bootstrapInstance",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BootstrapRequest" } } } },
        "responses": { "201": { "description": "Configured and signed in", "content": { "application/json": { "schema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "object", "required": ["user", "configured"], "properties": { "user": { "$ref": "#/components/schemas/User" }, "configured": { "type": "boolean" } } } } } } } } }
      }
    },
    "/setup/config": {
      "get": {
        "operationId": "getInstanceSettings",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Settings", "content": { "application/json": { "schema": { "type": "object", "required": ["data"], "properties": { "data": { "$ref": "#/components/schemas/InstanceSettings" } } } } } } }
      },
      "post": {
        "operationId": "updateInstanceSettings",
        "security": [{ "sessionCookie": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InstanceSettingsUpdate" } } } },
        "responses": { "200": { "description": "Updated settings", "content": { "application/json": { "schema": { "type": "object", "required": ["data"], "properties": { "data": { "$ref": "#/components/schemas/InstanceSettings" } } } } } } }
      }
    },
    "/auth/magic-link": {
      "post": {
        "operationId": "requestMagicLink",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["email"], "properties": { "email": { "type": "string", "format": "email" } } } } } },
        "responses": { "200": { "description": "Enumeration-resistant acknowledgement", "content": { "application/json": { "schema": { "type": "object", "required": ["message"], "properties": { "message": { "type": "string" } } } } } } }
      }
    },
    "/auth/verify": {
      "post": {
        "operationId": "verifyMagicLink",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["token"], "properties": { "token": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Session created", "content": { "application/json": { "schema": { "type": "object", "required": ["token", "organizer"], "properties": { "token": { "type": "string" }, "organizer": { "$ref": "#/components/schemas/User" } } } } } } }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "getCurrentUser",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Current user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } } }
      },
      "patch": {
        "operationId": "updateCurrentUser",
        "security": [{ "sessionCookie": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "properties": { "name": { "type": "string" }, "timezone": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Updated user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } } }
      }
